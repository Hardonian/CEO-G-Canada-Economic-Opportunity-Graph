# Copy to .env for local Docker Compose use. Use a generated secret; never
# commit the populated .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-local-secret
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000

# Official World Bank Indicators API is public and needs no credential.
# Set live only when the API runtime has outbound network access; snapshot is
# the deterministic default.
GLOBAL_TRADE_MODE=snapshot
GLOBAL_TRADE_FIXTURE=data/fixtures/world_bank_trade_canada.json

# Public AdSense publisher identifier (not a secret). Leave blank to disable
# ads entirely. Enable Auto ads + side rails in the approved AdSense account.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=

# Reserved for future promoted adapters. Never commit issued keys.
WTO_API_KEY=
UN_COMTRADE_API_KEY=
