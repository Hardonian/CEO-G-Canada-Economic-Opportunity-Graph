{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.canadaopportunitygraph.ca/cegs/0.1/dataset-manifest.schema.json",
  "title": "CEGS Dataset Manifest",
  "type": "object",
  "required": ["cegs", "id", "type", "dataset_id", "publisher", "license", "generated_at", "record_counts", "jurisdictions"],
  "properties": {
    "cegs": { "type": "string", "const": "0.1" },
    "id": { "type": "string", "pattern": "^cegs:manifest:[a-z0-9_-]+(:[a-z0-9_-]+)*$" },
    "type": { "type": "string", "const": "manifest" },
    "dataset_id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "publisher": { "type": "string" },
    "license": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "record_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "jurisdictions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "covered_time_period": {
      "type": "object",
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "schema_hashes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
