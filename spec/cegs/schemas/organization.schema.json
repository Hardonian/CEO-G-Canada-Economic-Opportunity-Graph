{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.canadaopportunitygraph.ca/cegs/0.1/organization.schema.json",
  "title": "CEGS Organization Resource",
  "type": "object",
  "required": ["cegs", "id", "type", "canonical_name", "jurisdiction", "entity_type", "created_at", "updated_at"],
  "properties": {
    "cegs": { "type": "string", "const": "0.1" },
    "id": { "type": "string", "pattern": "^cegs:org:ca(:[a-z0-9_-]+)*$" },
    "type": { "type": "string", "const": "organization" },
    "canonical_name": { "type": "string", "minLength": 1 },
    "legal_name": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "jurisdiction": { "type": "string" },
    "entity_type": {
      "type": "string",
      "enum": ["Corporation", "CrownCorp", "FirstNation", "GovernmentAgency", "Utility", "Investor", "Supplier"]
    },
    "website": { "type": "string" },
    "identifiers": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "description": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "provenance": { "type": "array", "items": { "type": "string" } },
    "extensions": { "type": "object" }
  }
}
