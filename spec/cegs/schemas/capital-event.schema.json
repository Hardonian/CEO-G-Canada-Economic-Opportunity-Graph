{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.canadaopportunitygraph.ca/cegs/0.1/capital-event.schema.json",
  "title": "CEGS Capital Event Resource",
  "type": "object",
  "required": ["cegs", "id", "type", "project_id", "category", "status", "amount", "provider_name", "evidence", "created_at"],
  "properties": {
    "cegs": { "type": "string", "const": "0.1" },
    "id": { "type": "string", "pattern": "^cegs:capital:[a-z0-9_-]+(:[a-z0-9_-]+)*$" },
    "type": { "type": "string", "const": "capital_event" },
    "project_id": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["equity", "debt", "grant", "tax_incentive", "loan_guarantee", "cib", "cgf", "indigenous_loan_guarantee", "pension", "strategic_corporate"]
    },
    "status": {
      "type": "string",
      "enum": ["announced", "proposed", "conditionally_committed", "committed", "closed", "disbursed", "estimated"]
    },
    "amount": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "integer" },
        "currency": { "type": "string", "const": "CAD" }
      }
    },
    "provider_entity_id": { "type": "string" },
    "provider_name": { "type": "string" },
    "notes": { "type": "string" },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
